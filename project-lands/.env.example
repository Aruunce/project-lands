# --- Database (Neon Postgres) ---
# Pooled connection string, used at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string, used for migrations.
DIRECT_URL=

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Map provider ---
# Selects the tile/style provider at runtime so it can be swapped without code changes.
NEXT_PUBLIC_MAP_PROVIDER=maplibre-osm
